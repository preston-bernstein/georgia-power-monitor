# Georgia Power Monitor environment variables (secrets).
# Copy this file to .env or export these variables via systemd's EnvironmentFile=.
# Never commit real credentials; this file documents the required variables only.

# Georgia Power username (email or account number). Required to authenticate with Georgia Power's API.
GP_USERNAME=your-georgia-power-email@example.com

# Georgia Power password. Required to authenticate with Georgia Power's API.
GP_PASSWORD=your-georgia-power-password

# Home Assistant long-lived access token. Required to POST usage/bill/poll-timestamp entities to HA.
# Generate this in HA's UI: Profile → Long-Lived Access Tokens → Create Token.
HA_LONG_LIVED_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
